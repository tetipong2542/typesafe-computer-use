<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.typesafe.worker</string>

    <key>WorkingDirectory</key>
    <string>/Users/admin/typesafe-computer-use</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/admin/typesafe-computer-use/scripts/run-worker.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/admin/typesafe-computer-use/runs/worker.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/admin/typesafe-computer-use/runs/worker.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/admin/typesafe-computer-use/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>WORKER_HOST</key>
        <string>0.0.0.0</string>
        <key>WORKER_PORT</key>
        <string>8000</string>
    </dict>
</dict>
</plist>
